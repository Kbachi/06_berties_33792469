<!doctype html>
<html>
  <head>
    <title>Login Audit</title>
    <link rel="stylesheet" type="text/css" href="/main.css" />
  </head>

  <body>
    <h1>Login Audit Log</h1>

    <table border="1" cellpadding="6">
      <tr>
        <th>Time</th>
        <th>Username</th>
        <th>Success</th>
        <th>IP Address</th>
        <th>User Agent</th>
      </tr>

      <% audit.forEach(row => { %>
        <tr>
          <td><%= row.event_time %></td>
          <td><%= row.username %></td>
          <td><%= row.success %></td>
          <td><%= row.ip_address %></td>
          <td><%= row.user_agent %></td>
        </tr>
      <% }) %>
    </table>

    <p><a href="/">Return home</a></p>
  </body>
</html>
